{
  "manifest_version": 3,
  "name": "Visa Reschedule Assistant",
  "version": "1.0",
  "description": "Automates login to usvisascheduling.com",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "https://www.usvisascheduling.com/*",
    "https://atlasauth.b2clogin.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.groq.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.usvisascheduling.com/*",
        "https://atlasauth.b2clogin.com/*"
      ],
      "js": ["captcha-service.js", "content.js"]
    }
  ]
}